{
  "manifest_version": 3,
  "name": "LeeGit",
  "version": "1.0.0",
  "description": "Sync accepted LeetCode solutions to GitHub.",

  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "https://leetcode.com/*",
    "https://api.github.com/*"
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.ico"
    }
  },

  "background": {
    "service_worker": "background/worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*"
      ],
      "js": [
        "content/leetcode.js"
      ]
    }
  ]
}
